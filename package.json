{
  "name": "dsh-toolbox-gjkt",
  "version": "0.0.11",
  "type": "module",
  "license": "MIT",
  "description": "DSH plugin: task notifications, selection toolbar, auto-continue and four agent tools, all configured in one 工具箱 settings section.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "tools.js",
    "cordis.patch.yml",
    "locale/en.json",
    "locale/zh.json",
    "docs/DETAIL.md",
    "docs/REMOTE-GUARD.md",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.19.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-api-gateway",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  }
}
